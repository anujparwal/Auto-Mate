<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AutoMateVault" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand / Primary -->
        <item name="colorPrimary">@color/vault_primary</item>
        <item name="colorOnPrimary">@color/vault_on_primary</item>
        <item name="colorPrimaryContainer">@color/vault_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/vault_on_primary_container</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/vault_surface</item>
        <item name="colorSurface">@color/vault_surface</item>
        <item name="colorOnSurface">@color/vault_on_surface</item>
        <item name="colorSurfaceVariant">@color/vault_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/vault_on_surface_variant</item>

        <!-- Outline / Divider -->
        <item name="colorOutline">@color/vault_outline</item>
        <item name="colorOutlineVariant">@color/vault_outline_variant</item>

        <!-- Error -->
        <item name="colorError">@color/vault_error</item>
        <item name="colorOnError">@color/vault_on_error</item>
        <item name="colorErrorContainer">@color/vault_error_container</item>
        <item name="colorOnErrorContainer">@color/vault_on_error_container</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/vault_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/vault_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
