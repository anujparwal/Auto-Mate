{
  "name": "auto-mate",
  "version": "0.1.0-preview.2",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "powershell.exe -NoProfile -File tools/setup-windows.ps1",
    "build:app": "powershell.exe -NoProfile -File tools/build-app.ps1",
    "check:app": "powershell.exe -NoProfile -File tools/check-app.ps1",
    "start": "bun run tools/start.ts",
    "test": "bun test",
    "smoke": "bun run tools/smoke.ts",
    "typecheck": "tsc --noEmit",
    "preview": "bun run tools/preview.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "playwright": "^1.64.1",
    "sharp": "0.35.5"
  }
}
